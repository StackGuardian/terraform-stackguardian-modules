# Authenticate before applying: aws sso login --profile <profile>
# Terraform creates the IAM user and access key, then stores the generated
# secret in Terraform state while registering the AWS_STATIC connector.
# Prefer examples/aws-oidc.tfvars.example for new integrations.
stackguardian_org_name = "example-org"
aws_region             = "eu-central-1"

workflow_groups = ["engineering"]
cloud_connectors = [{
  name                     = "aws-static"
  kind                     = "AWS_STATIC"
  iam_user_name            = "stackguardian-static"
}]

vcs_connectors = {}
role_name      = "engineering-developer"
template_list  = ["terraform-aws-vpc"]
subject        = "sg-test-sso/sso.user@domain.com"
entity_type    = "EMAIL"
