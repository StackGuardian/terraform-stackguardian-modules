# Set TF_VAR_stackguardian_api_key through a secret manager or environment variable.
# Do not place it in this file.
stackguardian_org_name = "example-org"

workflow_groups = ["engineering"]

# Terraform creates each selected cloud identity using the AWS CLI, Azure CLI, or
# gcloud application-default credentials and registers its generated identifiers.
# Prefer OIDC. Static connector kinds are retained only for legacy migrations.
cloud_connectors = [
  {
    name          = "aws-oidc"
    kind          = "AWS_OIDC"
    aws_region    = "eu-central-1"
    iam_role_name = "StackGuardianOidcRole"
  },
  {
    name                     = "azure-oidc"
    kind                     = "AZURE_OIDC"
    azure_subscription_id    = "00000000-0000-0000-0000-000000000000"
    azure_tenant_id          = "00000000-0000-0000-0000-000000000000"
    application_display_name = "stackguardian-oidc"
    role_definition_name     = "Reader"
  },
  {
    name                   = "gcp-oidc"
    kind                   = "GCP_OIDC"
    gcp_project_id         = "example-project"
    gcp_service_account_id = "stackguardian"
    gcp_workload_pool_id   = "stackguardian"
    gcp_provider_id        = "stackguardian-oidc"
    gcp_project_role       = "roles/viewer"
  },
]

vcs_connectors = {
  github = {
    name = "github"
    kind = "GITHUB_COM"
    github = {
      githubCreds = "<github-credential>"
    }
  }
  gitlab = {
    name = "gitlab"
    kind = "GITLAB_COM"
    gitlab = {
      gitlabCreds = "<gitlab-credential>"
    }
  }
  bitbucket = {
    name = "bitbucket"
    kind = "BITBUCKET_ORG"
    bitbucket = {
      bitbucket_creds = "<bitbucket-credential>"
    }
  }
}

role_name     = "engineering-developer"
template_list = ["terraform-aws-vpc"]
subject       = "developer@example.invalid"
entity_type   = "EMAIL"
