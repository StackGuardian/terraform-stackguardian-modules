# Set TF_VAR_stackguardian_api_key through a secret manager or environment variable.
# Do not place it in this file.
stackguardian_org_name = "example-org"

workflow_groups = ["engineering"]

# Static credentials and generated connector configuration are retained in state.
cloud_connectors = [
  {
    name              = "aws-static"
    kind              = "AWS_STATIC"
    aws_access_key_id = "<aws-access-key-id>"
    aws_secret_access_key = "<aws-secret-access-key>"
    aws_region = "eu-central-1"
  },
  {
    name            = "aws-rbac"
    kind            = "AWS_RBAC"
    aws_role_arn    = "arn:aws:iam::123456789012:role/StackGuardianRole"
    aws_external_id = "example-org:replace-with-external-id"
  },
  {
    name         = "aws-oidc"
    kind         = "AWS_OIDC"
    aws_role_arn = "arn:aws:iam::123456789012:role/StackGuardianOidcRole"
  },
  {
    name                  = "azure-static"
    kind                  = "AZURE_STATIC"
    azure_tenant_id       = "00000000-0000-0000-0000-000000000000"
    azure_subscription_id = "00000000-0000-0000-0000-000000000000"
    azure_client_id       = "00000000-0000-0000-0000-000000000000"
    azure_client_secret   = "<azure-client-secret>"
  },
  {
    name                  = "azure-oidc"
    kind                  = "AZURE_OIDC"
    azure_tenant_id       = "00000000-0000-0000-0000-000000000000"
    azure_subscription_id = "00000000-0000-0000-0000-000000000000"
    azure_client_id       = "00000000-0000-0000-0000-000000000000"
  },
  {
    name                    = "gcp-oidc"
    kind                    = "GCP_OIDC"
    gcp_config_file_content = "<gcp-external-account-configuration-json>"
  },
]

vcs_connectors = {
  github = {
    name = "github"
    kind = "GITHUB_COM"
    github = {
      githubCreds = "<github-credential>"
    }
  }
  gitlab = {
    name = "gitlab"
    kind = "GITLAB_COM"
    gitlab = {
      gitlabCreds = "<gitlab-credential>"
    }
  }
  bitbucket = {
    name = "bitbucket"
    kind = "BITBUCKET_ORG"
    bitbucket = {
      bitbucket_creds = "<bitbucket-credential>"
    }
  }
}

role_name     = "engineering-developer"
template_list = ["terraform-aws-vpc"]
subject       = "developer@example.invalid"
entity_type   = "EMAIL"
